  "document": {
    "schema_version": 1,
    "overview": [
      {
        "text": "Clinical teaching segment: rong kinh, rong huyết, underlying causes",
        "source_ids": [
          "6ab4e4b4d5f63c11cef670b80a0008e1",
          "51c7a4b34e67984705cbfeb2fc6d1016",
          "e6c768b08ed6366175dc06c14cc4a65b"
        ]
      }
    ],
    "key_topics": [
      {
        "text": "Normal menstruation: 3–5 days; sometimes 7 days; lower blood volume on days 5–7",
        "source_ids": [
          "6ab4e4b4d5f63c11cef670b80a0008e1",
          "a91b18631845e2e2ce37765237244231",
          "8939bedadd53f8c6216b974439cfeb74"
        ]
      },
      {
        "text": "Rong kinh: menstruation occurring on schedule but lasting over 7 days",
        "source_ids": [
          "3c7319ae10f9b14415f1250028922691",
          "a772f3b96ba0c4c7c601c809d526d1e7"
        ]
      },
      {
        "text": "Rong huyết: abnormal vaginal bleeding outside expected menstrual dates, prolonged",
        "source_ids": [
          "a772f3b96ba0c4c7c601c809d526d1e7",
          "67ba1d1ed2309bf61fd2a0707fa5c3ff",
          "51c7a4b34e67984705cbfeb2fc6d1016"
        ]
      },
      {
        "text": "Cause categories: functional and structural",
        "source_ids": [
          "e6c768b08ed6366175dc06c14cc4a65b",
          "e72f24bb125fca8ca118b9e9bac0441d"
        ]
      },
      {
        "text": "Functional causes: normal uterus and adnexa; ovarian estrogen or progesterone dysfunction; irregular or absent menstruation, prolonged vaginal bleeding",
        "source_ids": [
          "e72f24bb125fca8ca118b9e9bac0441d",
          "3838666b1d730a8347a069da4355b185",
          "f89d49bbc1ec6d583b3436ff1e9c7070",
          "7eda6cb6fbfef6acfabd86d5d45025e2",
          "57a88e0f24a272a1a1129590fdb37cd1"
        ]
      },
      {
        "text": "Structural causes: pathology in uterus, vagina or cervix",
        "source_ids": [
          "57a88e0f24a272a1a1129590fdb37cd1",
          "42f9b05b7d8c1df53a326cc0923f813d"
        ]
      },
      {
        "text": "Uterine fibroids: commonly encountered structural cause; intramural or subserosal locations less likely to cause rong kinh or rong huyết",
        "source_ids": [
          "270f6c23f373b6816f61b1a46c996a93",
          "1162e34933dba1a353e707f089fd49d6",
          "1620c21d9f1663f11725477be1ec095a",
          "075ccc7c07650594c6f6797dcef46784"
        ]
      },
      {
        "text": "Other structural causes: endometrial polyps, endometrial hyperplasia, endometrial cancer",
        "source_ids": [
          "b11cc4fe2cd8b9f2ac11854fd02e168f",
          "1e7941e5f5ed7f4eec65eb83b817fa2c"
        ]
      },
      {
        "text": "Genital-tract trauma or foreign bodies; possible vaginal leech after rural field exposure; frequent prolonged bleeding of initially unknown cause",
        "source_ids": [
          "7e5f7a9066bcb8f40d91132ebf5e5b6d",
          "8661ef789ba0add23df865ee5f42779b",
          "82e1d4e9bc438cb28d9fc5ce2697194a",
          "537b08949b2e7f1446f4955933d4d87c",
          "c0308753e444bd84a988eb04ef6012d7"
        ]
      },
      {
        "text": "Medical bleeding disorders: prolonged rong kinh or rong huyết from inability to stop bleeding",
        "source_ids": [
          "c2ff12a510c8518f136b7d6387fc1abc",
          "c67408e1d13e15e8a7ca95da15a80d9b"
        ]
      }
    ],
