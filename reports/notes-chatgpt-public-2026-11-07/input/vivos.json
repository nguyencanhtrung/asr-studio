{
  "id": "aa8af33acc9f36df531cd3ef636aa903",
  "meeting_id": "63d93320cb4ac6379617fc4e3ac20543",
  "meeting_date": null,
  "segments": [
    {
      "id": "43df003517ab06d4246e16b99837104b",
      "start_seconds": 0.0,
      "end_seconds": 1.0,
      "text": "Tuy nhiên, ca ghép đã hoàn tất như dự kiến, ông Liêm nói."
    },
    {
      "id": "921d72e48cfcdc8d77125af9b0a02a5b",
      "start_seconds": 1.0,
      "end_seconds": 2.0,
      "text": "Có nhiều người tôi còn nhớ được cả tên"
    },
    {
      "id": "71c31a2ef717d7ad599cf372283091e8",
      "start_seconds": 2.0,
      "end_seconds": 3.0,
      "text": "Ăn ở có nhân có nghĩa."
    },
    {
      "id": "1da6a216e8c6423c347025352de15bd3",
      "start_seconds": 3.0,
      "end_seconds": 4.0,
      "text": "Những loại thực phẩm này"
    },
    {
      "id": "50035c923509fe7fbf71e983234a21e4",
      "start_seconds": 4.0,
      "end_seconds": 5.0,
      "text": "Hai mươi sáu, hai mươi bảy."
    },
    {
      "id": "f332b3337e333ba02a3df6dd15e8fa8b",
      "start_seconds": 5.0,
      "end_seconds": 6.0,
      "text": "Sự buồn tẻ trong công việc có thể trở thành mảnh đất màu mỡ cho hoạt động sáng tạo."
    },
    {
      "id": "48c8a39380a3fdd09752e81edb893044",
      "start_seconds": 6.0,
      "end_seconds": 7.0,
      "text": "Nhiều điểm nóng đã hạ nhiệt."
    },
    {
      "id": "3521cb0fabdfdb5b4b8ef7a940af278d",
      "start_seconds": 7.0,
      "end_seconds": 8.0,
      "text": "Học bổng nghiên cứu sinh sau tiến sĩ tại Hàn Quốc."
    },
    {
      "id": "0dc76ba4c134aeca06dafa3afad78357",
      "start_seconds": 8.0,
      "end_seconds": 9.0,
      "text": "Trường Đại học Khoa học Tự nhiên Thành phố Hồ Chí Minh."
    },
    {
      "id": "e264b2f31bd52c20516a2a5a915d3012",
      "start_seconds": 9.0,
      "end_seconds": 10.0,
      "text": "Cảnh sát không thông báo về những gì chứa trong hai gói này."
    },
    {
      "id": "46cd478bfa545a5534f11369eae4372a",
      "start_seconds": 10.0,
      "end_seconds": 11.0,
      "text": "Mà khi chúng ta nắm giữ được"
    },
    {
      "id": "bef8e44423209db8a3d2d81b738140cf",
      "start_seconds": 11.0,
      "end_seconds": 12.0,
      "text": "hay thâm tím, chậm lành."
    },
    {
      "id": "aa2c08ad2164bd155ead778fd02ebf52",
      "start_seconds": 12.0,
      "end_seconds": 13.0,
      "text": "Mỗi mùa tuyển sinh cao đẳng, đại học là một mùa hội của làng Rồng."
    },
    {
      "id": "d3e55f0db70a772b30b5adea75335fae",
      "start_seconds": 13.0,
      "end_seconds": 14.0,
      "text": "Chúa ơi, chả lẽ lão ủn ỉn cũng có trí tuệ ư?"
    },
    {
      "id": "73e4a239006dcacec4f2c3a1368e4df8",
      "start_seconds": 14.0,
      "end_seconds": 15.0,
      "text": "Người người lại ra đồng, nhà nhà lại lo cấy hái."
    },
    {
      "id": "1679017f0ba8c1d7210b25c0756c90de",
      "start_seconds": 15.0,
      "end_seconds": 16.0,
      "text": "Khi tư vấn thì mọi người đều nói đem mẹ đến bệnh viện"
    },
    {
      "id": "31a6f364e1b3614aa985c980e3a0117b",
      "start_seconds": 16.0,
      "end_seconds": 17.0,
      "text": "mang tính cơ hội trong thị hiếu pháp"
    },
    {
      "id": "6da3f19f91095786866f02d2e03df975",
      "start_seconds": 17.0,
      "end_seconds": 18.0,
      "text": "Bốn mươi bốn, bốn mươi lăm."
    },
    {
      "id": "5b60f91b2b922de5511b48de39b9b676",
      "start_seconds": 18.0,
      "end_seconds": 19.0,
      "text": "Tôi muốn thời gian đó quan sát và tư duy, nhờ đó mà có ý tưởng điều chỉnh nhịp đèn, anh Tuấn chia sẻ."
    },
    {
      "id": "810163a8f40f8e8e96108343bf747b16",
      "start_seconds": 19.0,
      "end_seconds": 20.0,
      "text": "nhờ những nhà hùng biện dí dóm, hài hước."
    },
    {
      "id": "5151ac3b117b82d4944ccd99372db3b9",
      "start_seconds": 20.0,
      "end_seconds": 21.0,
      "text": "Con biết nịnh bố mỗi khi thích món đồ chơi nào đó."
    },
    {
      "id": "5f662d73ba14a3ec88d166b6d26b9499",
      "start_seconds": 21.0,
      "end_seconds": 22.0,
      "text": "Sáu mươi, sáu mươi mốt."
    },
    {
      "id": "322820036179cb93257cc7271dafd03f",
      "start_seconds": 22.0,
      "end_seconds": 23.0,
      "text": "Vừa qua cầu treo vừa câu cá (ảnh) Bốn chân di chuyển trên ba chiếc ghế nhựa bịt mắt qua cầu bập bênh đập niêu ném còn"
    },
    {
      "id": "693849e2f264f9e041b273d896f0930c",
      "start_seconds": 23.0,
      "end_seconds": 24.0,
      "text": "mà lại đứng bên ngoài cộng đồng."
    },
    {
      "id": "9022edcecd00cb06f6997940677c5604",
      "start_seconds": 24.0,
      "end_seconds": 25.0,
      "text": "Dạo đó, khi nghe có người chọc lá rụng về cội, ông Hai Chi rồi cũng chỉ một mình Chín Hoà tức lắm vì cậu rất thương ba nuôi."
    },
    {
      "id": "b61886b794c6ea6a583162498060f017",
      "start_seconds": 25.0,
      "end_seconds": 26.0,
      "text": "Sáu mươi bốn, sáu mươi lăm."
    },
    {
      "id": "e5be5feaa7a9aa16617c5aa604548031",
      "start_seconds": 26.0,
      "end_seconds": 27.0,
      "text": "Tuy nhiên, chi phí cho dự án này sẽ không rẻ chút nào."
    }
  ],
  "speakers": []
}